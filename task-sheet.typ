// ==========================================
// ЛИСТ ЗАДАНИЯ (форма — Приложение Б Положения о курсовом проектировании БГУИР)
// ==========================================

#let task = (
  faculty: "компьютерных систем и сетей",
  year: "2026",
  student: "Ермаков Виталий Сергеевич",
  student-short: "В. С. Ермаков",
  topic: "Разработка кроссплатформенного приложения «Маркетплейс»",
  deadline: "15 декабря 2026 г.",
  source-data: [
    язык программирования -- C++ (стандарт #box[C++23]); фреймворк для разработки
    графического интерфейса -- Qt 6 (модуль Qt Widgets); система сборки -- CMake;
    целевые операционные системы -- Windows и Linux; роли пользователей --
    администратор, продавец, покупатель; категории товаров и их характеристики
    формируются динамически во время работы программы; хранение данных --
    бинарные и текстовые файлы с поддержкой одновременной работы нескольких
    экземпляров приложения
  ],
  contents: (
    (0, [Лист задания]),
    (0, [Содержание]),
    (0, [Введение]),
    (0, [1\. Обзор литературы]),
    (1, [1.1. Обзор аналогов]),
    (1, [1.2. Обзор информационных технологий]),
    (1, [1.3. Постановка задачи]),
    (0, [2\. Функциональное проектирование]),
    (1, [2.1. Структура входных и выходных данных]),
    (1, [2.2. Разработка диаграммы классов]),
    (1, [2.3. Описание классов]),
    (0, [3\. Разработка программных модулей]),
    (1, [3.1. Разработка схем алгоритмов (два наиболее важных метода)]),
    (1, [3.2. Разработка алгоритмов (описание алгоритмов по шагам, для двух методов)]),
    (0, [4\. Результаты работы программы]),
    (0, [5\. Заключение]),
    (0, [6\. Список используемых источников]),
    (0, [7\. Приложения]),
  ),
  // TODO: заменить на конкретные методы после раздела 3
  graphics: (
    [Диаграмма классов.],
    [Схема алгоритма метода 1.],
    [Схема алгоритма метода 2.],
  ),
  consultant: "А. М. Ковальчук",
  issue-date: "15.09.2026 г.",
  // (этап, срок, трудоемкость)
  schedule: (
    ([Выбор задания. Разработка содержания пояснительной записки. Перечень графического материала], [к 01.10.2026], [5 %]),
    ([Раздел 1], [к 01.10.2026], [15 %]),
    ([Разделы 2, 3], [к 01.11.2026], [20 %]),
    ([Раздел 4], [к 01.12.2026], [40 %]),
    ([Раздел 5], [к 01.12.2026], [5 %]),
    ([Раздел 6], [к 11.12.2026], [5 %]),
    ([Оформление пояснительной записки и графического материала], [к 15.12.2026], [10 %]),
  ),
  defense: "с 21.12 по 28.12.2026 г.",
  manager: "А. М. Ковальчук",
)

// Линия, дотягивающаяся до правого края строки
#let fill-line = box(width: 1fr, outset: (bottom: 2pt), stroke: (bottom: 0.5pt))[]
// Заполненное поле бланка: подчеркнутый курсив + линия до конца строки
#let field(body) = [#underline(offset: 2pt, stroke: 0.5pt, evade: false, emph(body))#fill-line]
// Подпись под линией
#let caption-under(body) = text(size: 9pt, body)
// Пункт бланка: номер + текст, перенос строк с выравниванием по тексту
#let item(n, body) = block(above: 1em, grid(columns: (1.2em, 1fr), [#n.], body))
// Строка подписи: подпись слева, линия, расшифровка справа, пояснение под линией
#let sign-row(left, right, hint) = grid(
  columns: (auto, 1fr, auto),
  column-gutter: 0.6em,
  row-gutter: 0.25em,
  align: bottom,
  left, box(width: 100%, stroke: (bottom: 0.5pt))[#v(1em)], right,
  [], align(center, caption-under(hint)), [],
)

#[
  #set page(footer: none)
  #set par(first-line-indent: 0pt, justify: false, leading: 0.6em, spacing: 0.6em)
  #set text(size: 14pt)

  #align(center)[
    Учреждение образования \
    «Белорусский государственный университет информатики \
    и радиоэлектроники»
    #v(0.4em)
    Факультет #task.faculty
  ]

  #v(0.8em)
  #align(right, block(width: 7cm, align(left)[
    УТВЕРЖДАЮ \
    Заведующий кафедрой
    #v(1em)
    #line(length: 100%, stroke: 0.5pt)
    #v(-0.5em)
    #align(center, caption-under[(подпись)])
    #v(0.4em)
    «#box(width: 1.2cm, stroke: (bottom: 0.5pt))[]»
    #box(width: 3.2cm, stroke: (bottom: 0.5pt))[] #task.year г.
  ]))

  #v(1.2em)
  #align(center)[
    *ЗАДАНИЕ* \
    по курсовому проектированию
  ]
  #v(0.8em)

  Студенту #field(task.student)

  #item(1)[Тема проекта #field(task.topic)]
  #item(2)[Срок сдачи студентом законченного проекта #field(task.deadline)]
  #item(3)[Исходные данные к проекту #field(task.source-data)]
  #item(4)[
    Содержание расчетно-пояснительной записки (перечень вопросов, которые подлежат разработке):
    #block(above: 0.5em, inset: (left: 0.5em), stack(
      spacing: 0.4em,
      ..task.contents.map(((level, it)) => pad(left: level * 1.5em, emph(it))),
    ))
  ]

  #item(5)[
    Перечень графического материала (с точным обозначением обязательных чертежей и графиков):
    #block(above: 0.6em, stack(
      spacing: 0.6em,
      ..task.graphics.enumerate().map(((i, it)) => pad(left: 0.5em, field[#(i + 1). #it])),
    ))
  ]
  #item(6)[Консультант по проекту (с обозначением разделов проекта) #field(box(task.consultant))]
  #item(7)[Дата выдачи задания #field(task.issue-date)]
  #item(8)[
    Календарный график работы над проектом на весь период проектирования (с обозначением сроков выполнения и трудоемкости отдельных этапов):
    #block(above: 0.8em, table(
      columns: (1fr, auto, auto),
      stroke: 0.5pt,
      inset: (x: 0.4em, y: 0.35em),
      align: (left + horizon, center + horizon, center + horizon),
      table.header([*Этап*], [*Срок*], [*Объем*]),
      ..task.schedule.map(((stage, date, share)) => (emph(stage), emph(date), emph(share))).flatten(),
    ))
    #v(0.4em)
    Защита курсового проекта #field(task.defense)
  ]

  #v(3em)
  #sign-row([РУКОВОДИТЕЛЬ], task.manager, [(подпись)])
  #v(2em)
  #sign-row([Задание принял к исполнению], task.student-short, [(дата и подпись студента)])
]

#pagebreak()
